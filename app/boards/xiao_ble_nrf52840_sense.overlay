 *
 * Expose the 2 MB on-board QSPI flash (P25Q16H) as a USB Mass Storage disk.
 * Enable the on-board PDM microphone for audio recording.
 *
 * The internal-flash storage_partition defined in
 * nrf52840_partition_uf2_sdv7.dtsi is deleted and re-created on the external
 * QSPI flash instead.  The msc_disk0 node ties the partition to the USB MSC
 * "NAND" LUN declared in main.c.
 */

/delete-node/ &storage_partition;

&p25q16h {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		storage_partition: partition@0 {
			label = "storage";
			reg = <0x00000000 0x00200000>; /* 2 MB */
		};
	};
};

/ {
	msc_disk0 {
		compatible = "zephyr,flash-disk";
		partition = <&storage_partition>;
		disk-name = "NAND";
		cache-size = <4096>;
	};

	/* Add a label to the microphone power regulator so C code can obtain
	 * the device via DT_NODELABEL(mic_pwr) and call regulator_enable(). */
	mic_pwr: msm261d3526hicpm-c-en {};
};

/* PDM0 is disabled by default in the nRF52840 DTSI; enable it here.
 * The recording design uses a separate FAT-writer thread so the PDM reader
 * frees slab blocks almost immediately (just a memcpy).  queue-size=4 is
 * therefore sufficient: 2 (HW double-buffer) + 2 (rx_queue margin) = 4. */
&pdm0 {
	status = "okay";
	queue-size = <4>;
};
