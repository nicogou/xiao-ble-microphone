# This file is the application Kconfig entry point. All application Kconfig
# options can be defined here or included via other application Kconfig files.
# You can browse these options using the west targets menuconfig (terminal) or
# guiconfig (GUI).

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"

config APP_PITCH
	bool "Pitch detection"
	help
	  Real-time monophonic pitch detector (MPM algorithm).
	  Shell commands: pitch start/stop/status.

config APP_REC
	bool "WAV recording"
	help
	  WAV recording to the external QSPI flash via FAT.
	  Requires FILE_SYSTEM and FAT_FILESYSTEM_ELM.
	  Shell commands: record start/stop/status.

config APP_KWS
	bool "Keyword spotting"
	help
	  Keyword spotting using the Edge Impulse SDK.
	  Requires EDGE_IMPULSE_SDK, CPP, and GLIBCXX_LIBCPP.
	  Shell commands: kws start/stop/status.

config APP_IMU
	bool "IMU motion detection"
	default y
	depends on I2C && GPIO
	help
	  Enable significant motion detection using the LSM6DS3TR-C IMU on
	  the XIAO BLE Sense.  Events are logged at INF level via the "imu"
	  log module.  The module starts automatically at boot via SYS_INIT.
	  Requires LSM6DSL_TRIGGER_NONE so that this module owns the INT1
	  GPIO line (set CONFIG_LSM6DSL_TRIGGER_NONE=y in prj.conf).

config APP_DISPLAY_UI
	bool "Round display UI (LVGL)"
	depends on LVGL && DISPLAY && APP_PITCH
	select LV_FONT_MONTSERRAT_32
	help
	  Enable the LVGL-based round display UI for the Seeed XIAO Round Display.
	  Build with --shield seeed_xiao_round_display.
